---
import Base from '../layouts/Base.astro';
import { photos } from '../lib/data.js';
---
<Base title="Photos" description="Friday night photo galleries from Louisiana high school football, credited to the photographers who shot them.">
<section class="pg"><div class="wrap">
<div class="head"><span class="kick">Photos</span><h1>Photos</h1><p class="muted">Every photo carries its photographer’s credit.</p></div>
<div class="gal">{photos.map((p) => <button type="button" data-src={p.image || ''} data-alt={p.alt} data-cap={`${p.title}${p.game ? '. ' + p.game : ''}. Photo: ${p.photographer}`}>{p.image ? <img class="pic" src={p.image} alt={p.alt} loading="lazy" /> : <div class="ph">Photo coming soon</div>}<span class="muted">Photo: {p.photographer}</span></button>)}</div>
</div></section>
<dialog id="lb" aria-label="Photo viewer"><img id="lbi" alt="" style="width:100%;border-radius:12px;display:none"><p id="lbc"></p><a class="lnk" href="/contact/?topic=removal">Request removal</a> <button class="pill line" type="button" id="lbx">Close</button></dialog>
<script is:inline>
var d=document.getElementById('lb'),im=document.getElementById('lbi');document.querySelectorAll('.gal button').forEach(function(b){b.onclick=function(){document.getElementById('lbc').textContent=b.dataset.cap;if(b.dataset.src){im.src=b.dataset.src;im.alt=b.dataset.alt;im.style.display='block'}else{im.style.display='none'}d.showModal()}});
document.getElementById('lbx').onclick=function(){d.close()};d.onclick=function(e){if(e.target===d)d.close()};
</script>
</Base>
