---
import { homeCarousel } from '../lib/data.js';
const { photos, shuffle, seconds } = homeCarousel;
const total = photos.length + 1;
---
<section class="hc" id="hc" aria-roledescription="carousel" aria-label="Blue 42 Productions photos" data-shuffle={shuffle ? '1' : '0'} data-seconds={seconds}>
  <div class="hc-stage" id="hc-stack">
    <figure class="hc-card hc-logo" data-cap="" data-by="">
      <img src="/logo-white-bg.png" alt="Blue 42 Productions" width="225" height="225" />
    </figure>
    {photos.map((p, i) => (
      <figure class="hc-card" data-cap={p.caption || ''} data-by={p.photographer || ''} aria-hidden="true">
        {p.image
          ? <img src={p.image} alt={p.alt || p.caption || 'Blue 42 photo'} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
          : <span class="hc-ph" aria-hidden="true">42</span>}
      </figure>
    ))}
  </div>
  <p class="hc-cap" aria-live="off"><span id="hc-t"></span></p>
</section>
<script is:inline>
(function(){
var root=document.getElementById('hc'),stage=document.getElementById('hc-stack');if(!root||!stage)return;
var deck=[].slice.call(stage.children);
// Shuffle the photos on each visit; the logo always opens in the middle.
if(root.dataset.shuffle==='1'){var r=deck.slice(1);for(var i=r.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=r[i];r[i]=r[j];r[j]=t}deck=[deck[0]].concat(r)}
var N=deck.length,cur=0,ms=(Number(root.dataset.seconds)||8)*1000,timer=null,tEl=document.getElementById('hc-t');
function paint(){deck.forEach(function(c,k){var d=(k-cur+N)%N,pos=d===0?'0':d===1&&N>1?'1':d===N-1&&N>2?'-1':'x';c.dataset.p=pos;c.setAttribute('aria-hidden',pos==='0'?'false':'true')});
  var top=deck[cur];tEl.textContent=[top.dataset.cap,top.dataset.by?'Photo: '+top.dataset.by:''].filter(Boolean).join('  ·  ')}
function schedule(){clearTimeout(timer);if(N<2||document.hidden)return;timer=setTimeout(function(){cur=(cur+1)%N;paint();schedule()},ms)}
document.addEventListener('visibilitychange',schedule);
paint();schedule();
})();
</script>
